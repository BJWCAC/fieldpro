{
  "description": "CapStone Zoho CRM field reference for Internal Assets (company tools / IAxxxx records).",
  "source": "Live Zoho CRM /crm/v3/settings/fields?module=Internal_Assets via get_internal_asset_fields (proxy build 289), 2026-08-14.",
  "notes": [
    "Internal_Assets is a separate module from Equipments. CapStone IA tab must only show fields that exist on Internal_Assets.",
    "Name is the autonumber Internal Asset Number (IAxxxx). There is no IA_Asset_ID field.",
    "Descriptive title is Internal_Asset_Name (not Name).",
    "Brand / Part_Number / Description / GPS_Tag are Internal_Assets api names — do not use Asset_Brand, Asset_Model_Number, Description_Instructions, or Location_Coordinates.",
    "Equipments-only CapStone fields (Asset Category, Function, Building, Designator, Type, Series, Environment, Confined Space, category layouts, Subform_1, Model_AI_Specs, Account, Deal notes) stay hidden on the IA tab."
  ],
  "internalAssetCapturePhase1": {
    "moduleApiName": "Internal_Assets",
    "layoutName": "Standard",
    "idField": "Name",
    "idSearchPrefix": "IA",
    "idLabel": "IA Number",
    "requiredFields": [
      "Internal_Asset_Name",
      "Serial_Number",
      "Use_Status"
    ],
    "fields": [
      { "apiName": "Name", "label": "IA Number", "widget": "text", "readOnly": true, "zohoLabel": "Internal Asset Number" },
      { "apiName": "Internal_Asset_Name", "label": "IA Name", "widget": "text", "zohoLabel": "Internal Asset Name" },
      { "apiName": "Brand", "label": "Brand", "widget": "text" },
      { "apiName": "Part_Number", "label": "Part Number", "widget": "text" },
      { "apiName": "Serial_Number", "label": "Serial Number", "widget": "text" },
      { "apiName": "Tag", "label": "Tag", "widget": "text" },
      { "apiName": "Use_Status", "label": "Use Status", "widget": "select", "picklist": "Use_Status" },
      { "apiName": "Users", "label": "Current User", "widget": "select", "picklist": "Users" },
      { "apiName": "Calibration_Due_Date", "label": "Calibration Due Date", "widget": "date" },
      { "apiName": "Currency_1", "label": "Cost", "widget": "number" },
      { "apiName": "Currency", "label": "Currency", "widget": "select" },
      { "apiName": "GPS_Tag", "label": "GPS Tag", "widget": "text" },
      { "apiName": "Description", "label": "Description", "widget": "textarea" }
    ],
    "internalOnlyFields": [
      "Use_Status",
      "Users",
      "Internal_Asset_Name",
      "Brand",
      "Part_Number",
      "Calibration_Due_Date",
      "Currency_1",
      "Currency",
      "GPS_Tag",
      "Tag"
    ],
    "photoExtractionTargets": [
      "Brand",
      "Part_Number",
      "Serial_Number",
      "Internal_Asset_Name"
    ],
    "defaults": {
      "Use_Status": "Permenant",
      "Currency": "USD"
    },
    "skipFields": [
      "Account",
      "Customer_Asset_Number",
      "Asset_Category",
      "Asset_Function",
      "Building",
      "Additional_Designator",
      "Asset_Brand",
      "Asset_Type",
      "Asset_Series",
      "Asset_Environment",
      "Confined_Space",
      "Asset_Model_Number",
      "Nameplate_Additional_Info",
      "Description_Instructions",
      "Model_AI_Specs",
      "Location_Coordinates",
      "Subform_1"
    ],
    "proxyActions": {
      "create": "create_internal_asset",
      "update": "update_internal_asset",
      "delete": "delete_internal_asset",
      "get": "get_internal_asset",
      "search": "search_internal_assets",
      "findBySerial": "find_internal_asset",
      "uploadPhoto": "upload_internal_asset_photo",
      "saveNote": "save_internal_asset_note",
      "activateLayout": "activate_internal_asset_category_layout"
    }
  }
}
