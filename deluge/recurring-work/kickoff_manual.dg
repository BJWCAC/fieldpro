string button.Deal_Create_Single_Record(String Id)
{
getRecurring = zoho.crm.getRecordById("Recurring_Work",Id.toLong());
// info getRecurring ;
getGenerate_Time_Span_Days = getRecurring.get("Generate_Time_Span_Days");
getNext_Service_Date = getRecurring.get("Next_Service_Date");
getName = getRecurring.get("Name");
getTechnician_Service_Notes = getRecurring.get("Technician_Service_Notes");
getWorkorder_Item_Type = getRecurring.get("Workorder_Item_Type");
AccountId = "";
ContactId = "";
getAccount = getRecurring.get("Account");
getContact = getRecurring.get("Contacts");
if(getAccount != null)
{
	AccountId = getAccount.get("id");
}
if(getContact != null)
{
	ContactId = getContact.get("id");
}
getCustomer_PO = ifnull(getRecurring.get("Customer_PO"),"");
getAmount = ifnull(getRecurring.get("Amount"),"");
getTechnician = ifnull(getRecurring.get("Technician"),"");
sub_forms = List();
/*Subform Asset */
getAssets_and_Products = ifnull(getRecurring.get("Assets_and_Products"),"");
for each  Items in getAssets_and_Products
{
	if(Items != null)
	{
		subform = Map();
		subform.put("Assets",Items.get("Assets").get("id"));
		sub_forms.add(subform);
	}
}
sub_tables = List();
/*Subform Product */
getProductsSubform = ifnull(getRecurring.get("Products_Tools"),"");
for each  products in getProductsSubform
{
	if(products != null)
	{
		subtable = Map();
		subtable.put("Products",products.get("Products").get("id"));
		//getProductName = products.get("Products").get("name");
		subtable.put("Quantity",products.get("Quantity"));
		sub_tables.add(subtable);
	}
}
dealmap = Map();
//LayoutId=3631313000007898916
dealmap.put("Layout","3631313000007898916");
dealmap.put("Deal_Name",getName);
dealmap.put("Description",getTechnician_Service_Notes);
dealmap.put("Workorder_Item_Type","Calib - Recurr");
dealmap.put("Account_Name",AccountId);
dealmap.put("Contact_Name",ContactId);
dealmap.put("Customer_PO",getCustomer_PO);
dealmap.put("Amount",getAmount);
dealmap.put("Preferred_Technician",getTechnician.get("id"));
dealmap.put("Recurring_Work_Lookup",input.Id);
dealmap.put("Stage","Active");
dealmap.put("Recurring_or_T_M_Troubleshooting","Recurring");
dealmap.put("Assets_and_Checklist",sub_forms);
dealmap.put("Time_Tracker",sub_tables);
// new code of addition pipeline logic
/* The logic should be: 
	If Service Type = On Site, create the Deal in the Jobs pipeline.
	If Service Type = Mail-In Lab, create the Deal in the Inhouse Lab pipeline.
*/
Service_Type = ifnull(getRecurring.get("Service_Type"),"");
if(Service_Type == "On Site")
{
	dealmap.put("Pipeline","3631313000034293042");
	// Jobs
}
else if(Service_Type == "Mail In Lab")
{
	dealmap.put("Pipeline","3631313000136915992");
	// InHouse Lab
}
// end of pipeline script
info dealmap;
dataList = List();
dataList.add(dealmap);
param = Map();
param.put("data",dataList);
// Trigger workflow, approval, blueprint, orchestration as needed
triggerList = List();
triggerList.add("workflow");
param.put("trigger",triggerList);
CreateDeal = invokeurl
[
	url :"https://www.zohoapis.com/crm/v8/Deals"
	type :POST
	parameters:param.toString()
	connection:"zoho_pipeline_scope"
];
// end of new api call
// deal = zoho.crm.getRecordById("Deals","3631313000040248005");
// info deal;
//CreateDeal = zoho.crm.createRecord("Deals",dealmap,{"trigger":{"workflow"}});
info "Create Deal : " + CreateDeal;
if(CreateDeal.get("data").size() > 0)
{
	dealResponse = CreateDeal.get("data").get(0);
	dealId = dealResponse.get("details").get("id");
	if(dealId != null)
	{
		deal = zoho.crm.getRecordById("Deals",dealId);
		getJobID = deal.get("Job_ID");
		newDealName = getName + " - " + getJobID;
		mymap = Map();
		mymap.put("Layout","3631313000007898916");
		mymap.put("Deal_Name",newDealName);
		UpdateDeal = zoho.crm.updateRecord("Deals",dealId,mymap);
		//info UpdateDeal;
		//laura==3631313000019565001
		if(UpdateDeal.get("id") != null)
		{
			dealId = UpdateDeal.get("id");
			/*---------------- Next Kick off Service Date ------------*/
			recurMap = Map();
			newNext_Service_Date = getNext_Service_Date.addMonth(getGenerate_Time_Span_Days).toString("yyyy-MM-dd");
			//info newNext_Service_Date ;
			recurMap.put("Next_Service_Date",newNext_Service_Date);
			recurUpdate = zoho.crm.updateRecord("Recurring_Work",Id,recurMap);
			info "recurUpdate : " + recurUpdate;
		}
	}
}
dealResponse = CreateDeal.get("data").get(0);
getid = dealResponse.get("details").get("id");
getmsg = dealResponse.get("message");
if(getid != null)
{
	openUrl("https://crm.zoho.com/crm/org678237898/tab/Potentials/" + getid,"new window");
	return "";
}
else
{
	return "Error: " + getmsg;
}
}