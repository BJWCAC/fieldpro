// Trigger: Date-based workflow on Recurring_Work at K − 30 days (Next_Service_Date minus 30)
// Workflow criteria: Active_Inactive = true; function exits if no Ship_Ahead rows. Args: rwId
void automation.rw_prep_materials(String rwId)
{
BOOKS_ORG_ID = "714953277";
APPROVER_ID = "3631313000000183017";
errors = List();
rw = zoho.crm.getRecordById("Recurring_Work",rwId.toLong());
info "1 loaded RW: " + rw.get("Name");
if(rw.get("Active_Inactive") != true)
{
	info "STOP: inactive";
	return;
}
shipRows = List();
for each  row in ifnull(rw.get("Products_Tools"),List())
{
	if(row != null && row.get("Ship_Ahead") == true)
	{
		shipRows.add(row);
	}
}
info "2 ship-ahead rows: " + shipRows.size();
if(shipRows.size() == 0)
{
	return;
}
matStatus = ifnull(rw.get("Materials_Status"),"");
if(matStatus == "")
{
	matStatus = "Not Required";
}
if(matStatus != "Not Required")
{
	info "STOP: status already " + matStatus;
	return;
}
if(ifnull(rw.get("Books_PO_Number"),"") != "")
{
	info "STOP: PO already created " + rw.get("Books_PO_Number");
	return;
}
refNum = ifnull(rw.get("Recurring_Work_ID"),"RW-" + rwId);
accountName = "";
if(rw.get("Account") != null)
{
	accountName = rw.get("Account").get("name");
}
siteContact = rw.get("Contact_On_Site");
if(siteContact == null)
{
	siteContact = rw.get("Contacts");
}
contactName = "";
if(siteContact != null)
{
	contactName = siteContact.get("name");
}
vendorBuckets = Map();
itemSummary = List();
for each  srow in shipRows
{
	prodRef = srow.get("Products");
	if(prodRef != null)
	{
		qty = ifnull(srow.get("Quantity"),1);
		prod = zoho.crm.getRecordById("Products",prodRef.get("id").toLong());
		productCode = ifnull(prod.get("Product_Code"),"").trim();
		productName = ifnull(prod.get("Product_Name"),"");
		itemSummary.add(qty.toString() + " x " + productName);
		vendorName = "";
		if(prod.get("Vendor_Name") != null)
		{
			vendorName = prod.get("Vendor_Name").get("name");
		}
		info "3 product: " + productCode + " / vendor: " + vendorName;
		booksItemId = "";
		itemsResp = zoho.books.getRecords("Items",BOOKS_ORG_ID,"sku=" + encodeUrl(productCode),"recurringwork");
		info "4 Books item lookup: " + itemsResp;
		if(itemsResp.get("items") != null && itemsResp.get("items").size() > 0)
		{
			booksItemId = itemsResp.get("items").get(0).get("item_id");
		}
		vendorId = "";
		if(vendorName != "")
		{
			vendResp = zoho.books.getRecords("Contacts",BOOKS_ORG_ID,"contact_type=vendor&contact_name=" + encodeUrl(vendorName),"recurringwork");
			info "5 Books vendor lookup: " + vendResp;
			if(vendResp.get("contacts") != null && vendResp.get("contacts").size() > 0)
			{
				vendorId = vendResp.get("contacts").get(0).get("contact_id");
			}
		}
		if(booksItemId == "")
		{
			errors.add("Books item not found for SKU " + productCode);
		}
		else if(vendorId == "")
		{
			errors.add("Books vendor not found: " + vendorName);
		}
		else
		{
			lineItem = Map();
			lineItem.put("item_id",booksItemId);
			lineItem.put("quantity",qty);
			vendorLines = List();
			if(vendorBuckets.containKey(vendorId))
			{
				vendorLines = vendorBuckets.get(vendorId);
			}
			vendorLines.add(lineItem);
			vendorBuckets.put(vendorId,vendorLines);
		}
	}
}
info "6 errors so far: " + errors;
poNumbers = List();
for each  vk in vendorBuckets.keys()
{
	po = Map();
	po.put("vendor_id",vk);
	po.put("reference_number",refNum);
	po.put("line_items",vendorBuckets.get(vk));
	po.put("notes","Ship to CAC. For customer job: " + accountName + " (" + refNum + ").");
	resp = zoho.books.createRecord("PurchaseOrders",BOOKS_ORG_ID,po,"recurringwork");
	info "7 PO create: " + resp;
	if(resp.get("purchaseorder") != null)
	{
		poNumbers.add(resp.get("purchaseorder").get("purchaseorder_number"));
	}
	else
	{
		errors.add("PO create failed: " + resp.get("message"));
	}
}
if(poNumbers.size() == 0)
{
	info "STOP: no PO created. Errors: " + errors;
	return;
}
poJoined = poNumbers.toString(",");
rwUpdate = Map();
rwUpdate.put("Materials_Status","PO Pending");
rwUpdate.put("Books_PO_Number",poJoined);
info "8 RW update: " + zoho.crm.updateRecord("Recurring_Work",rwId.toLong(),rwUpdate);
taskMap = Map();
taskMap.put("Subject","Approve PO - " + accountName + " - " + refNum);
taskMap.put("Owner",APPROVER_ID);
taskMap.put("Due_Date",zoho.currentdate.addDay(3).toString("yyyy-MM-dd"));
taskMap.put("What_Id",rwId);
taskMap.put("$se_module","Recurring_Work");
taskMap.put("Description","PO number(s): " + poJoined + "\nItems: " + itemSummary + "\nErrors: " + errors);
info "9 task: " + zoho.crm.createRecord("Tasks",taskMap);
// Cliq alert disabled until a Cliq connection exists; errors are in the task description.
}
